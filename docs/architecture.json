    {
      "dot": "cyan",
      "title": "Markdown is the source of truth",
      "items": [
        "Every memory lives in MEMORY.md, USER.md, projects-memory or failures.md",
        "SQLite is a rebuildable mirror — restore it with /memory-sync-markdown"
      ]
    },
    {
      "dot": "emerald",
      "title": "The review clock",
      "items": [
        "10 user turns or 15 tool calls, at least 3 user turns, one review at a time",
        "Direct side-channel completion first; pi -p subprocess is the fallback"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing saves itself silently",
      "items": [
        "Content scan rejects secrets and injection before a store write",
        "Skill proposals wait for /memory-skill-approve; an empty review stays quiet"
      ]
